# AI Doctor Webapp — Environment Variables
# Rename this file to .env and fill in your values

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# JWT Secret — koi bhi random string (32+ chars)
JWT_SECRET=change-this-to-random-secret-min-32-chars

# Razorpay Keys (from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Port (Railway/Render auto-set karte hain)
PORT=3000

# Database path (optional — default: ./doctors.db)
DB_PATH=./doctors.db
